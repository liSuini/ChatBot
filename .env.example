# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=changeme

# ===== Backend =====
# 数据库连接（docker-compose 中由上方 MySQL 变量自动拼接，本地开发可直接填完整 URL）
# DATABASE_URL=mysql+aiomysql://chatbot:changeme@localhost:3306/chatbot

# JWT
SECRET_KEY=change-me-in-production-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
DEFAULT_LLM_PROVIDER=mock
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=xingchen-pro
XINGCHEN_EMBED_MODEL=xingchen-embedding
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# 嵌入模型（文档向量化用，可独立于对话模型）
# 默认与 DEFAULT_LLM_PROVIDER 相同；若对话模型不支持 Embedding（如 DeepSeek），
# 可单独指定为 openai/xingchen，或设为 mock 让文档上传不失败（RAG 检索效果有限）
# EMBED_PROVIDER=mock

# 限流（可选，有默认值）
# RATE_LIMIT_GENERAL=60/minute
# RATE_LIMIT_LLM=20/minute

# 文件上传（可选，有默认值）
# MAX_FILE_SIZE=10485760
# SYNC_PROCESS_THRESHOLD=5242880

# RAG（可选，有默认值）
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
